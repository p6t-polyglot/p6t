{
  "name": "@p6t/cli",
  "version": "0.0.0",
  "description": "Developer CLI for p6t — extract, push, pull, and check translation coverage",
  "type": "module",
  "bin": {
    "p6t": "./dist/p6t"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun build --compile src/index.ts --outfile dist/p6t",
    "build:dev": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "i18n",
    "translation",
    "cli",
    "polyglot"
  ],
  "author": "",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@types/gettext-parser": "^9.0.0",
    "@types/node": "^25.6.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.72",
    "@ai-sdk/google": "^3.0.65",
    "@ai-sdk/mistral": "^3.0.31",
    "@ai-sdk/openai": "^3.0.54",
    "@clack/prompts": "^1.2.0",
    "@lingui/conf": "^6.0.0",
    "@openrouter/ai-sdk-provider": "^2.9.0",
    "@p6t/config": "workspace:*",
    "ai": "^6.0.169",
    "ai-sdk-ollama": "^3.8.3",
    "citty": "^0.2.2",
    "gettext-parser": "^9.0.2",
    "zod": "^4.4.3"
  }
}
